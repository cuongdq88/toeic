            {
              "key": "A",
              "text": "issue"
            },
            {
              "key": "B",
              "text": "publish"
            },
            {
              "key": "C",
              "text": "release"
            },
            {
              "key": "D",
              "text": "deliver"
            }
          ],
          "answer": "A",
          "explanation": {
            "why_correct": "'Issue a refund' là collocation đúng nghĩa hoàn tiền.",
            "why_wrong": {
              "B": "'Publish a refund' không phải cụm đúng.",
              "C": "'Release a refund' không dùng trong ngữ cảnh này.",
              "D": "'Deliver a refund' không phải cách nói chuẩn."
            },
            "translation_vi": "Hãng bay đồng ý hoàn tiền toàn bộ trong năm ngày làm việc."
