              "text": "at"
            },
            {
              "key": "D",
              "text": "by"
            }
          ],
          "answer": "A",
          "explanation": {
            "why_correct": "Dùng 'on' trước thứ trong tuần và ngày cụ thể.",
            "why_wrong": {
              "B": "'In' dùng cho tháng/năm.",
              "C": "'At' dùng cho giờ.",
              "D": "'By' chỉ hạn chót."
