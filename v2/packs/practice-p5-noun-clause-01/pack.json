            {
              "key": "A",
              "text": "when"
            },
            {
              "key": "B",
              "text": "that"
            },
            {
              "key": "C",
              "text": "which"
            },
            {
              "key": "D",
              "text": "whose"
            }
          ],
          "answer": "A",
          "explanation": {
            "why_correct": "'When' dẫn mệnh đề danh từ chỉ thời gian.",
            "why_wrong": {
              "B": "'That' không hợp nghĩa hỏi giờ.",
              "C": "'Which' cần danh từ chỉ lựa chọn.",
              "D": "'Whose' chỉ sở hữu."
            },
            "translation_vi": "Vui lòng cho tôi biết chuyến tàu tiếp theo rời đi khi nào."
          },
          "tags": [
            "g20_noun_clauses"
          ]
        }
