          "answer": "A",
          "explanation": {
            "why_correct": "Cụm 'responsible for' + V-ing/danh từ.",
            "why_wrong": {
              "B": "'Responsible of' không đúng.",
              "C": "'Responsible to' chỉ báo cáo cho ai.",
              "D": "'Responsible with' không đúng."
